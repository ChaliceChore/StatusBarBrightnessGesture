<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Themed-icon (monochrome) layer — the system applies its own tint: the launcher mask shows only the
         centre 72x72 of this 108x108 canvas, so all artwork stays within a
         48dp-wide circle (radius 24 from centre) to avoid crowding the mask. -->

    <!-- Sun disc centred at 54,54 radius 14 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M54,40 a14,14 0 1,0 0.001,0 Z"/>

    <!-- 8 rays, from radius 18 out to radius 24
         (diagonals: 18*cos45=12.73, 24*cos45=16.97) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="
            M54,36 L54,30
            M54,72 L54,78
            M36,54 L30,54
            M72,54 L78,54
            M41.27,41.27 L37.03,37.03
            M66.73,41.27 L70.97,37.03
            M41.27,66.73 L37.03,70.97
            M66.73,66.73 L70.97,70.97"/>

</vector>
